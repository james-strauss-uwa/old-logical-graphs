                "f05b1997-55ec-4409-a441-fd5393ed2fc0": {
                    "name": "func_code",
                    "value": "spw_range = \"\"for n in range(len(selinfo[\"ms_0\"][\"spw\"])):         spw_range = (             f\"{spw_range}{selinfo['ms_0']['spw'][n]}:\"             f\"{selinfo['ms_0']['start'][n]}~\"             f\"{selinfo['ms_0']['start'][n] + selinfo['ms_0']['nchan'][n]}\"         )          if (n + 1) < len(selinfo[\"ms_0\"][\"spw\"]):             spw_range += \",\"",
                    "defaultValue": "",
                    "description": "Python function code, e.g. 'def func_name(args): return args'. Note that func_name above needs to match the defined name here.",
                    "readonly": false,
                    "type": "String",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "encoding": "pickle",
                    "id": "f05b1997-55ec-4409-a441-fd5393ed2fc0",
